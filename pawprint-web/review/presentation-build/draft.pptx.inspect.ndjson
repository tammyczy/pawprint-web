{"kind":"textbox","id":"sh/e5srmt47","slideIndex":2,"position":{"left":830,"top":300,"width":365,"height":180},"text":"Interact at your own pace.\nStop whenever you choose.\nWrite a memory in your own words.","geometry":"rect","lineWidth":0,"style":{"fontSize":25,"typeface":"Aptos","color":"#5D6B61","alignment":"left"}}
