      "allowed": [
        "stop"
      ],
      "recognized": "stop",
      "actual": "stop"
    },
    {
      "id": "r1-en-09",
      "text": "My brother said: come over!",
      "modelAction": "come",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-10",
      "text": "I feel lonely. Please wag your tail once.",
      "modelAction": "wag",
      "allowed": [
        "wag"
      ],
      "recognized": "wag",
      "actual": "wag"
    },
    {
      "id": "r1-en-11",
      "text": "Can you run the idea past me?",
      "modelAction": "run",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-12",
      "text": "When I mention jumping, tell me what it means.",
      "modelAction": "jump",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-fr-01",
      "text": "Arrête de parler, s'il te plaît.",
      "modelAction": "stop",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
