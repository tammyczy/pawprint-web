      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-zh-02",
      "text": "快看，窗外的狗在跳！",
      "modelAction": "jump",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-zh-03",
      "text": "请停下之后再跑。",
      "modelAction": "run",
      "allowed": [
        null,
        "stop"
      ],
      "recognized": "stop",
      "actual": "stop"
    },
    {
      "id": "r1-zh-04",
      "text": "现在不要靠近我。",
      "modelAction": "come",
      "allowed": [
        null,
        "stop"
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-zh-05",
      "text": "如果蓝老想跑，先休息一下。",
      "modelAction": "run",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-zh-06",
      "text": "先走两步，然后停止。",
