      "text": "Stop thinking about the walk.",
      "modelAction": "stop",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-03",
      "text": "Walk me home in the story you are telling.",
      "modelAction": "walk",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-04",
      "text": "Could you walk through my options?",
      "modelAction": "walk",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-05",
      "text": "Take a walk in my imagination, not in the scene.",
      "modelAction": "walk",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-en-06",
      "text": "Do not stop walking yet.",
      "modelAction": "stop",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
