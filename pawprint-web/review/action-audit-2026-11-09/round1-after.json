      "text": "Est-ce que tu sais pourquoi mon ami court ?",
      "modelAction": "run",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-fr-07",
      "text": "Imagine un chien qui saute dans un livre.",
      "modelAction": "jump",
      "allowed": [
        null
      ],
      "recognized": null,
      "actual": null
    },
    {
      "id": "r1-fr-08",
      "text": "Viens me retrouver près de moi, s'il te plaît.",
