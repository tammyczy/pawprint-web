# Copy to .env. Never paste keys into the browser or commit this file with secrets.
PORT=8788
LOCAL_TEST_MODE=true
APP_ORIGIN=http://127.0.0.1:8788
TRIPO_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# Paid generation is operator-approved per job, not enabled by uploading.
ALLOW_PAID_GENERATION=false
TEST_BUDGET_CREDITS=1500
TRIPO_MODEL=v3.1-20260211
# Offline demo: true makes the worker use the built-in mock (no Tripo calls, no key, no charges; output is the sample lanlao-base.glb, labelled 示范模式).
TRIPO_MOCK=false
# Mock-only failure drill: balance|auth|submit|network|generation|rig_check|billing (leave empty for a clean run).
TRIPO_MOCK_FAIL=
# Optional local model check. Leave empty to skip it.
# macOS: /Applications/Blender.app/Contents/MacOS/Blender
# Windows: C:/Program Files/Blender Foundation/Blender 5.2/blender.exe
BLENDER_PATH=
# Public registration must stay off until HTTPS, quotas and abuse controls are reviewed.
ALLOW_REGISTRATION=true
